rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// The client enforces the scoring logic, so these rules add a second line of
// defence: verified email, per-field limits, cooldown, bounded point changes and a
// fixed exchange rate from points to JSDP points.
// A production deployment should move scoring into a Cloud Function.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Any authenticated user may participate with Google or email/password without waiting for
    // email verification. Admin access below still requires verified Google sign-in.
    function isUpjStudent() {
      return signedIn();
    }

    function isOwner(uid) {
      return isUpjStudent() && request.auth.uid == uid;
    }

    // The single admin account. It reviews scans and may read every user's scans, photos and
    // profile. The Google provider is required, so an email and password account that happens to
    // use the same address does not qualify. Keep the address in step with ADMIN_EMAIL in lib/admin.ts.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.get('email', '').lower() == 'lintararyadwi@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // An admin decision on one scan. The whole map is replaced on every review, and the
    // reviewer address and time cannot be forged. A rejection must say why.
    function isValidReview(review) {
      return review.keys().hasOnly(['status', 'note', 'reviewedBy', 'reviewedAt'])
        && review.status in ['approved', 'rejected']
        && review.note is string
        && review.note.size() <= 500
        && (review.status == 'approved' || review.note.size() > 0)
        && review.reviewedBy == request.auth.token.email
        && review.reviewedAt == request.time;
    }

    match /users/{uid} {
      // `poin` is read with a default so profiles created before the field existed
      // can still be updated.
      function oldPoin() {
        return resource.data.get('poin', 0);
      }

      function newPoin() {
        return request.resource.data.get('poin', 0);
      }

      // Scan hanya boleh mengurangi poin saat pelanggaran otomatis (maks -3) dan mengatur
      // cooldown (5 menit normal, 15 menit pelanggaran). Poin hasil scan baru masuk ke saldo
      // setelah disetujui admin lewat isAdminPointUpdate().
      function isScanUpdate() {
        return request.resource.data.poinJSDP == resource.data.poinJSDP
          && request.resource.data.totalScan == resource.data.totalScan
          && newPoin() <= oldPoin()
          && newPoin() >= oldPoin() - 3
          && (
            request.resource.data.cooldownUntil == resource.data.cooldownUntil
            || (
              request.resource.data.cooldownUntil > request.time
              && request.resource.data.cooldownUntil <= request.time + duration.value(16, 'm')
            )
          );
      }

      // Pemilik akun yang dinonaktifkan tidak boleh memperbarui profil, scan, atau penukaran.
      function isNotDisabled() {
        return resource.data.get('disabled', false) != true;
      }

      // Admin menyetujui scan atau mengelola saldo, waktu jeda penalti, dan status akun pengguna.
      // Identitas dasar dan poinJSDP tetap tidak bisa diubah admin.
      function isAdminUserUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let nextNote = request.resource.data.get('penaltyNote', null);
        let nextDisableReason = request.resource.data.get('disabledReason', null);
        return isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.poinJSDP == resource.data.poinJSDP
          && changed.hasOnly([
            'poin',
            'totalScan',
            'cooldownUntil',
            'penaltyNote',
            'penaltyUpdatedAt',
            'penaltyUpdatedBy',
            'disabled',
            'disabledReason',
            'disabledAt'
          ])
          && newPoin() is int && newPoin() >= 0
          && request.resource.data.totalScan is int && request.resource.data.totalScan >= 0
          && (nextNote == null || (nextNote is string && nextNote.size() <= 500))
          && (nextDisableReason == null || (nextDisableReason is string && nextDisableReason.size() <= 300))
          && request.resource.data.get('disabled', false) is bool
          && (
            !changed.hasAny(['penaltyUpdatedAt', 'penaltyUpdatedBy'])
            || (
              request.resource.data.penaltyUpdatedBy == request.auth.token.email
              && request.resource.data.penaltyUpdatedAt == request.time
            )
          )
          && (
            !changed.hasAny(['disabledAt'])
            || request.resource.data.disabledAt == null
            || request.resource.data.disabledAt == request.time
          );
      }

      // An exchange spends whole packages of 10 points for 5 JSDP points each.
      // Keep these numbers in step with EXCHANGE_POIN and EXCHANGE_JSDP in
      // lib/scoring.ts. It leaves scan counters and the cooldown untouched.
      function isExchangeUpdate() {
        let spent = oldPoin() - newPoin();
        let gained = request.resource.data.poinJSDP - resource.data.poinJSDP;
        return request.resource.data.totalScan == resource.data.totalScan
          && request.resource.data.cooldownUntil == resource.data.cooldownUntil
          && spent > 0
          && spent % 10 == 0
          && gained * 10 == spent * 5;
      }

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.poin == 0
        && request.resource.data.poinJSDP == 0
        && request.resource.data.totalScan == 0
        && request.resource.data.cooldownUntil == null
        && request.resource.data.get('disabled', false) == false;

      // Identity fields and admin-managed moderation fields are protected from owner writes.
      allow update: if (
        isOwner(uid)
        && isNotDisabled()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
        && request.resource.data.get('disabledReason', null) == resource.data.get('disabledReason', null)
        && request.resource.data.get('disabledAt', null) == resource.data.get('disabledAt', null)
        && request.resource.data.get('penaltyNote', null) == resource.data.get('penaltyNote', null)
        && request.resource.data.get('penaltyUpdatedAt', null) == resource.data.get('penaltyUpdatedAt', null)
        && request.resource.data.get('penaltyUpdatedBy', null) == resource.data.get('penaltyUpdatedBy', null)
        && newPoin() >= 0
        && request.resource.data.poinJSDP >= 0
        && (isScanUpdate() || isExchangeUpdate())
      ) || isAdminUserUpdate();

      allow delete: if isAdmin()
        && resource.data.get('email', '').lower() != 'lintararyadwi@gmail.com';
    }

    // One document per exchange. The amounts must match the change that the same
    // write makes to the user document (get = before, getAfter = after).
    match /exchanges/{exchangeId} {
      allow read: if (isUpjStudent() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isUpjStudent()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && request.resource.data.keys().hasOnly(['exchangeId', 'userId', 'poinSpent', 'jsdpGained', 'timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.exchangeId == exchangeId
        && request.resource.data.poinSpent > 0
        && request.resource.data.poinSpent % 10 == 0
        && request.resource.data.jsdpGained * 10 == request.resource.data.poinSpent * 5
        && request.resource.data.poinSpent
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('poin', 0)
            - getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.poin
        && request.resource.data.timestamp == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /scans/{scanId} {
      // Tebakan pengenal foto (lib/ml/classify.ts). Hanya catatan, tidak memengaruhi poin,
      // jadi cukup dibatasi bentuk dan ukurannya. binId opsional: model sebelum sampah-v3 tidak mengirimnya.
      function isMlSuggestion(s) {
        return s is map
          && s.keys().hasOnly(['classId', 'confidence', 'itemId', 'binId', 'suggested', 'accepted', 'modelVersion', 'loadMs', 'inferMs', 'blockedTries'])
          && s.classId is string && s.classId.size() <= 32
          && s.confidence is number && s.confidence >= 0 && s.confidence <= 1
          && (s.itemId == null || (s.itemId is string && s.itemId.size() <= 64))
          && (s.get('binId', null) == null || s.binId in ['organik', 'plastik_kertas', 'residu'])
          && s.suggested is bool
          && s.accepted is bool
          && s.modelVersion is string && s.modelVersion.size() <= 32
          && s.loadMs is number && s.loadMs >= 0
          && s.inferMs is number && s.inferMs >= 0
          && (s.get('blockedTries', 0) is int && s.get('blockedTries', 0) >= 0 && s.get('blockedTries', 0) <= 50);
      }

      allow read: if (isUpjStudent() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isUpjStudent()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.scanId == scanId
        && request.resource.data.categoryBin in ['organik', 'plastik_kertas', 'residu']
        && request.resource.data.pointsEarned >= -3
        && request.resource.data.pointsEarned <= 7
        && request.resource.data.timestamp == request.time
        && (request.resource.data.get('mlSuggestion', null) == null
          || isMlSuggestion(request.resource.data.mlSuggestion));

      // The only change an admin may make to a scan is its review. Points are never touched here.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])
        && isValidReview(request.resource.data.review);
      allow delete: if isAdmin();
    }

    // Proof photos are stored as compressed JPEG data URLs. A document is capped
    // at 1 MiB, so the client compresses to under 300 KB and the rule allows 400 KB.
    match /scanPhotos/{scanId} {
      allow read: if (isUpjStudent() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isUpjStudent()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.scanId == scanId
        && request.resource.data.mime == 'image/jpeg'
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 400000
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // Quiz bank. The correct answers already ship in the client bundle, so reading
    // is public. Managers edit questions in the Firebase Console or through the
    // Admin SDK (npm run seed), never from the app.
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Kamus sampah + soal cek cepat yang dikelola admin. Dibaca publik oleh halaman utama.
    match /wasteItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'label', 'category', 'question', 'choices', 'correctIndex',
          'reason', 'deleted', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == itemId
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 120
        && request.resource.data.category in ['organik', 'plastik_kertas', 'residu']
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 300
        && request.resource.data.choices is list
        && request.resource.data.choices.size() == 2
        && request.resource.data.choices[0] is string
        && request.resource.data.choices[0].size() > 0
        && request.resource.data.choices[0].size() <= 100
        && request.resource.data.choices[1] is string
        && request.resource.data.choices[1].size() > 0
        && request.resource.data.choices[1].size() <= 100
        && request.resource.data.correctIndex in [0, 1]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 400
        && request.resource.data.deleted is bool
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

  }
}
