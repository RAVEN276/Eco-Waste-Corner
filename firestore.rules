rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// The client enforces the scoring logic, so these rules add a second line of
// defence: verified email, per-field limits, cooldown, bounded point changes and a
// fixed exchange rate from points to JSDP points.
// A production deployment should move scoring into a Cloud Function.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Any email domain may sign in (Google, or email and password), but the email must
    // be verified. Email and password accounts verify through the link Firebase sends.
    // The name is historical: it no longer checks for a UPJ student address.
    function isUpjStudent() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isUpjStudent() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // `poin` is read with a default so profiles created before the field existed
      // can still be updated.
      function oldPoin() {
        return resource.data.get('poin', 0);
      }

      function newPoin() {
        return request.resource.data.get('poin', 0);
      }

      // A scan only moves `poin` (JSDP points stay put): down by a penalty of at
      // most 3, or up by at most 7 when the cooldown has passed and a new cooldown
      // window is written in the same update.
      function isScanUpdate() {
        return request.resource.data.poinJSDP == resource.data.poinJSDP
          && request.resource.data.totalScan >= resource.data.totalScan
          && request.resource.data.totalScan <= resource.data.totalScan + 1
          && (
            (
              newPoin() <= oldPoin()
              && newPoin() >= oldPoin() - 3
            )
            || (
              newPoin() <= oldPoin() + 7
              && (resource.data.cooldownUntil == null || resource.data.cooldownUntil <= request.time)
              && request.resource.data.cooldownUntil > request.time
              && request.resource.data.cooldownUntil <= request.time + duration.value(16, 'm')
            )
          );
      }

      // An exchange spends whole packages of 10 points for 5 JSDP points each.
      // Keep these numbers in step with EXCHANGE_POIN and EXCHANGE_JSDP in
      // lib/scoring.ts. It leaves scan counters and the cooldown untouched.
      function isExchangeUpdate() {
        let spent = oldPoin() - newPoin();
        let gained = request.resource.data.poinJSDP - resource.data.poinJSDP;
        return request.resource.data.totalScan == resource.data.totalScan
          && request.resource.data.cooldownUntil == resource.data.cooldownUntil
          && spent > 0
          && spent % 10 == 0
          && gained * 10 == spent * 5;
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.poin == 0
        && request.resource.data.poinJSDP == 0
        && request.resource.data.totalScan == 0
        && request.resource.data.cooldownUntil == null;

      // Identity fields are immutable. JSDP points count toward graduation: they
      // never fall and only rise through an exchange of `poin`.
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && newPoin() >= 0
        && request.resource.data.poinJSDP >= 0
        && (isScanUpdate() || isExchangeUpdate());

      allow delete: if false;
    }

    // One document per exchange. The amounts must match the change that the same
    // write makes to the user document (get = before, getAfter = after).
    match /exchanges/{exchangeId} {
      allow read: if isUpjStudent() && resource.data.userId == request.auth.uid;

      allow create: if isUpjStudent()
        && request.resource.data.keys().hasOnly(['exchangeId', 'userId', 'poinSpent', 'jsdpGained', 'timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.exchangeId == exchangeId
        && request.resource.data.poinSpent > 0
        && request.resource.data.poinSpent % 10 == 0
        && request.resource.data.jsdpGained * 10 == request.resource.data.poinSpent * 5
        && request.resource.data.poinSpent
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('poin', 0)
            - getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.poin
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    match /scans/{scanId} {
      allow read: if isUpjStudent() && resource.data.userId == request.auth.uid;

      allow create: if isUpjStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.scanId == scanId
        && request.resource.data.categoryBin in ['organik', 'plastik_kertas', 'residu']
        && request.resource.data.pointsEarned >= -3
        && request.resource.data.pointsEarned <= 7
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // Proof photos are stored as compressed JPEG data URLs. A document is capped
    // at 1 MiB, so the client compresses to under 300 KB and the rule allows 400 KB.
    match /scanPhotos/{scanId} {
      allow read: if isUpjStudent() && resource.data.userId == request.auth.uid;
      allow create: if isUpjStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.scanId == scanId
        && request.resource.data.mime == 'image/jpeg'
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 400000
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }


  }
}
