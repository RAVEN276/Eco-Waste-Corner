# Firebase Console > Project settings > Your apps > Web app > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opsional. Alamat pengirim email verifikasi dan reset kata sandi yang ditampilkan di layar login. Isi dengan alamat
# yang kamu pasang di Firebase Console > Authentication > Templates > SMTP Settings. Kosong berarti
# noreply@<AUTH_DOMAIN>, pengirim bawaan Firebase.
NEXT_PUBLIC_LOGIN_EMAIL_SENDER=
